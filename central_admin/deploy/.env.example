# Copiar para .env.production somente na VPS (chmod 600).
# Não versionar a senha. A chave precisa ter ao menos 32 caracteres.
CENTRAL_TOKEN=SUBSTITUIR_POR_CHAVE_ALEATORIA_FORTE
# Usuário exclusivo e SOMENTE LEITURA no PostgreSQL.
CENTRAL_CONTROLES_DSN=postgresql://USUARIO_SELECT:SENHA_URL_ENCODED@db:5432/meus_controles
