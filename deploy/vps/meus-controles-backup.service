[Unit]
Description=Backup SQLite verificado - Central de Controles
After=local-fs.target

[Service]
Type=oneshot
User=meuscontroles
Group=meuscontroles
WorkingDirectory=/opt/apps/meus-controles
Environment=CONTROLES_DATA_DIR=/var/lib/meus-controles
Environment=CONTROLES_BACKUP_DIR=/var/backups/meus-controles
ExecStart=/usr/bin/python3 /opt/apps/meus-controles/deploy/vps/BACKUP.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/meus-controles /var/backups/meus-controles
