[Unit]
Description=Central de Controles - servidor web privado
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=meuscontroles
Group=meuscontroles
WorkingDirectory=/opt/apps/meus-controles
Environment=PYTHONUNBUFFERED=1
Environment=CONTROLES_DATA_DIR=/var/lib/meus-controles
Environment=CONTROLES_PORT=18765
Environment=CONTROLES_DISABLE_LOCAL_SHUTDOWN=1
EnvironmentFile=/etc/meus-controles.env
ExecStart=/usr/bin/python3 /opt/apps/meus-controles/app.py
Restart=always
RestartSec=4
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/meus-controles
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
